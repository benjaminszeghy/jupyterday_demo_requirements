#!/bin/bash
set -e
mkdir -p ${NB_PYTHON_PREFIX}/etc/jupyter/jupyter_server_config.d
cat > ${NB_PYTHON_PREFIX}/etc/jupyter/jupyter_server_config.d/default_kernel.json << 'EOF'
{
  "MappingKernelManager": {
    "default_kernel_name": "xpython"
  }
}
EOF

# Claude Code (npm global install lands in the conda env, which is on PATH)
npm install -g @anthropic-ai/claude-code
# ACP adapter; jupyter-ai's @Claude persona only loads if `claude-agent-acp` is on PATH
npm install -g @zed-industries/claude-agent-acp
